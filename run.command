#!/bin/bash

# Переходим в директорию скрипта
cd "$(dirname "$0")"

echo "======================================"
echo " Подготовка окружения для конвертации "
echo "======================================"

# Проверяем наличие виртуального окружения, создаем если нет
if [ ! -d "venv" ]; then
    echo "Создаю виртуальное окружение (это нужно сделать один раз)..."
    python3 -m venv venv
fi

# Активируем окружение
source venv/bin/activate

# Устанавливаем зависимости (если уже установлены, пройдет быстро)
echo "Проверка библиотек..."
pip install -q Pillow pillow-heif

# Создаем папки на всякий случай
mkdir -p input
mkdir -p output

# Запускаем сам скрипт
echo "Запуск конвертера..."
python3 convert.py

# Деактивируем окружение
deactivate

echo ""
read -p "Нажмите Enter для выхода..."
